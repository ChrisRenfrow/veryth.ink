{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "~/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "allowJs": true
  },
  // Prevent `astro check` from checking js under public
  "exclude": ["public"]
}
